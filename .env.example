NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site origin. Production checkout redirects use only this value.
# In development, a loopback Host such as localhost:3001 overrides it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
# server-only: used ONLY in order creation Server Action and Stripe webhook
SUPABASE_SERVICE_ROLE_KEY=
# server-only Stripe keys — never use NEXT_PUBLIC_ prefix
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# server-only recurring PLUS price id
STRIPE_PLUS_PRICE_ID=
# Print commerce is fail-closed by default. Keep disabled until every release
# gate in lib/print/commerce-readiness.ts is resolved.
PRINT_COMMERCE_MODE=disabled
PRINT_PROVIDER=mock
PRODIGI_ENV=sandbox
PRODIGI_API_KEY=
# local/test-only entitlement override (FREE or PLUS); ignored in production
UCHINOCO_DEV_PLAN_OVERRIDE=
# server-only comma-separated auth user UUID allowlist for /dev/metrics in production
UCHINOCO_INTERNAL_USER_IDS=
